{
  "name": "@kensio/smartass",
  "description": "TypeScript-first test assertion functions with precise type narrowing",
  "author": "Kensio Software",
  "repository": "https://github.com/KensioSoftware/smartass",
  "homepage": "https://smartassertions.dev/",
  "license": "Apache-2.0",
  "version": "1.38.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/smartass-eslint.config.d.ts",
      "import": "./dist/eslint/smartass-eslint.config.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint/smartass-oxlint-plugin.d.ts",
      "import": "./dist/oxlint/smartass-oxlint-plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "build:index": "bash scripts/build-index.sh",
    "build:readme": "bash scripts/build-readme-lists.sh",
    "fmt": "oxlint --fix && prettier --write .",
    "lint": "oxlint && prettier --check .",
    "test": "vitest run --typecheck",
    "test:coverage": "vitest run --typecheck --coverage",
    "check": "pnpm fmt && pnpm build:check && pnpm test:coverage"
  },
  "keywords": [
    "test",
    "assertion",
    "type",
    "narrowing"
  ],
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^10.6.0",
    "eslint-plugin-jsdoc": "^63.0.12",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.4",
    "semantic-release": "25.0.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  }
}
